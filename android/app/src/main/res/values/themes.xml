<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base app theme (used after splash) -->
    <style name="Theme.DailyOK" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash screen theme (Activity starting theme) -->
    <style name="Theme.DailyOK.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/dailyok_green</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/dailyok_green</item>
        <item name="postSplashScreenTheme">@style/Theme.DailyOK</item>
    </style>
</resources>
