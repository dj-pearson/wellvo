    <!-- Receiver Setup Guide -->
    <string name="setup_guide_title">Invite Sent!</string>
    <string name="setup_guide_subtitle">%1$s will receive a text message with instructions to get started.</string>
    <string name="setup_guide_steps_title">What %1$s needs to do:</string>
    <string name="setup_guide_step1_title">Open the Text Message</string>
    <string name="setup_guide_step1_desc">%1$s will receive a text with a link to download Daily OK from the Play Store.</string>
    <string name="setup_guide_step2_title">Download the App</string>
    <string name="setup_guide_step2_desc">Tap the link in the text to open the Play Store and download Daily OK.</string>
    <string name="setup_guide_step3_title">Sign In with Their Phone Number</string>
    <string name="setup_guide_step3_desc">Open the app and enter the same phone number the text was sent to. They\'ll receive a verification code.</string>
    <string name="setup_guide_step4_title">Allow Notifications</string>
    <string name="setup_guide_step4_desc">The app will ask to send notifications. This is required so they receive their daily check-in reminder.</string>
    <string name="setup_guide_step5_title">That\'s It!</string>
    <string name="setup_guide_step5_desc">The app automatically connects them to your family. Each day at the scheduled time, they just tap \"I\'m OK.\"</string>
    <string name="setup_guide_tips">Tips</string>
    <string name="setup_guide_tip_1">Make sure %1$s uses the exact phone number you entered when signing in.</string>
    <string name="setup_guide_tip_2">If they don\'t see the text, check that the phone number is correct and try re-sending the invite.</string>
    <string name="setup_guide_tip_3">The app will automatically match them to your family — no codes or links to enter.</string>
    <string name="setup_guide_tip_4">You can adjust the check-in schedule anytime from the Family tab.</string>

