<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Enforce TLS for all connections in production -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
        Certificate pinning for Supabase domain (dailyok.net and subdomains).
        Pins to Let's Encrypt ISRG Root X1 (primary) and ISRG Root X2 (backup).
        Expiration set to 1 year — update pins before expiry.
        If your Supabase domain differs from *.dailyok.net, update the domain below.
    -->
    <domain-config>
        <domain includeSubdomains="true">dailyok.net</domain>
        <pin-set expiration="2027-04-01">
            <!-- ISRG Root X1 (Let's Encrypt primary root) -->
            <pin digest="SHA-256">C5+lpZ7tcVwmwQIMcRtPbsQtWLABXhQzejna0wHFr8M=</pin>
            <!-- ISRG Root X2 (Let's Encrypt backup root) -->
            <pin digest="SHA-256">diGVwiVYbubAI3RW4hB9xU8e/CH2GnkuvVFZE8zmgzI=</pin>
        </pin-set>
    </domain-config>

    <!-- Debug builds can optionally trust user-added CAs (pinning bypassed in debug) -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
