# CSP notes. script-src carries no 'unsafe-inline': every <script> in the
# prerendered HTML is either external (src=) or a non-executable data block
# (application/json, application/ld+json), and GA is injected as an external
# script by src/lib/consent.ts. Google host wildcards follow Google's GA4 CSP
# guidance (regional *.google-analytics.com / *.analytics.google.com endpoints).
# img-src already allows any https: origin, which covers the GA pixel.
# No report-uri/report-to: there is no CSP report endpoint yet — add one here
# when it exists rather than pointing at a guess.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=(), browsing-topics=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://*.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https: blob:; connect-src 'self' https://cloudflareinsights.com https://api.dailyok.net wss://api.dailyok.net https://functions.dailyok.net https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.ingest.us.sentry.io; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

# Universal Links: AASA must be served as JSON with no redirect (US-IOS109).
/.well-known/apple-app-site-association
  Content-Type: application/json

# Self-hosted Inter (US-WEB020). The filename carries the upstream Inter
# version, so a font update ships under a new name and this immutable year
# is safe — never overwrite these files in place.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Build output (US-SEO012). Cloudflare Pages sends
# `public, max-age=0, must-revalidate` for everything it is not told about, so
# all 1.4 MB of JS and CSS under /assets was being revalidated on every
# navigation despite the filenames being content-hashed. A hash change produces
# a NEW path, so a year is safe here in a way it never is for HTML.
#
# Deliberately NOT extended to the rest of the site: index.html and the
# index.pageContext.json beside it keep their stable names across deploys, so
# an immutable year on those would pin visitors to a stale build with no way to
# recover. sitemap.xml, robots.txt and llms.txt stay revalidated for the same
# reason — a crawler must see them fresh.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Brand assets keep stable filenames, so they get a week rather than a year,
# with stale-while-revalidate so replacing one is picked up in the background
# instead of costing the next visitor a blocking fetch. Listed individually
# rather than by extension: these are the whole set, and an over-broad rule
# here would silently catch a future hashed or user-uploaded image.
/og-image.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/og-image.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/favicon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/icon-16.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/icon-32.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/icon-192.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/icon-512.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/Logo.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/Logo-White.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/Icon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Admin is a client-only SPA surface that _redirects rewrites to the homepage
# shell, so a crawler that reached it would be served the homepage's HTML under
# an /admin URL (US-SEO010). robots.txt already disallows it and the footer link
# is nofollowed; this is the third layer, and the only one that still applies if
# the Disallow is ever relaxed.
#
# The admin session holds a Supabase JWT, so the authenticated surface gets a
# second, stricter CSP on top of the site-wide one. Cloudflare Pages sends
# both (joined into one comma-separated header) and browsers enforce every
# policy, so the effective rule is the intersection: no third-party script
# (GA, the Cloudflare beacon) runs here, and fetches can only reach this
# origin, the Supabase/edge-function hosts and Sentry. no-store keeps the
# authenticated admin view out of shared caches and the back/forward cache.
/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Content-Security-Policy: script-src 'self'; connect-src 'self' https://api.dailyok.net wss://api.dailyok.net https://functions.dailyok.net https://*.ingest.us.sentry.io; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
/admin
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Content-Security-Policy: script-src 'self'; connect-src 'self' https://api.dailyok.net wss://api.dailyok.net https://functions.dailyok.net https://*.ingest.us.sentry.io; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
