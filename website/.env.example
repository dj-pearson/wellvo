# Website environment variables (prefix VITE_ exposes to the browser)

# Supabase — anon key is public, safe to ship in the bundle (RLS enforces access)
VITE_SUPABASE_URL=https://your-supabase-instance.example.com
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base URL of the edge-functions service (Coolify container)
VITE_EDGE_FUNCTIONS_URL=https://api.dailyok.net

# Cloudflare Web Analytics site token (32 hex chars, from the Cloudflare
# dashboard → Web Analytics → your site → "JS snippet"). Optional: when it is
# unset the beacon <script> is omitted entirely rather than shipped with a
# placeholder token, so leaving it blank costs nothing (US-SEO004). Set it in
# the Cloudflare Pages build environment for production.
VITE_CF_ANALYTICS_TOKEN=
