# Edge Functions Environment Variables
# Copy to .env and fill in values

# Supabase connection (internal Docker network URL)
SUPABASE_URL=http://supabase-kong:8000
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
JWT_SECRET=your-jwt-secret-here

# APNs Push Notifications (from Apple Developer portal)
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_PRIVATE_KEY=base64-encoded-p8-key
APNS_ENVIRONMENT=development    # or "production"

# CORS (restrict to your domain)
ALLOWED_ORIGIN=https://dailyok.net

# Server port
PORT=9000

# Server-sent SMS is OFF. Texts between family members are sent from the
# phone's own Messages app (pre-filled by Daily OK), not by this server, because
# server SMS needs an A2P 10DLC registration. Only "true" turns it back on, and
# it then also needs the Twilio settings below.
SMS_ENABLED=false
# Twilio SMS (unused unless SMS_ENABLED=true)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM_NUMBER=+1234567890
# Preferred for A2P 10DLC: route through the approved campaign's Messaging Service.
# When set, takes precedence over TWILIO_FROM_NUMBER.
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
