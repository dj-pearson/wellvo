<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily OK Watch App — Apple Privacy Manifest

  The watchOS app. It performs check-ins through the same edge function the phone uses, reading the session from its own device-local Keychain and the shared snapshot. It collects nothing beyond what the main app declares.

  Apple's required-reason API check (ITMS-91053) runs per BUNDLE, not per app
  record: the main app's manifest does not cover a separate extension or watch
  binary. Data-collection declarations for the product as a whole live in
  ios/DailyOK/PrivacyInfo.xcprivacy and must stay in step with the App Store
  Connect "App Privacy" answers and website/src/pages/Privacy.tsx.

  UserDefaults (1C8F.1) is the only required-reason API this bundle calls:
  it reads/writes the shared App Group container (group.com.wellvo.ios) via
  SharedAppGroup.swift and never touches UserDefaults.standard, so CA92.1
  (app-only defaults) does not apply. FileTimestamp, SystemBootTime and
  DiskSpace are not declared because no first-party code in this target calls
  those APIs (system frameworks are exempt). Re-add one if that changes.
-->
<plist version="1.0">
<dict>
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>1C8F.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
